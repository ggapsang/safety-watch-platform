# .env.example — 복사해서 .env 로 쓰세요. (⚠ .env 는 자격증명 포함 — 커밋 금지)

# ── 영상 ─────────────────────────────────────────────────────────────
# RTSP URL / 동영상 파일 경로 / 웹캠 인덱스(0)
VIDEO_SOURCE=rtsp://admin:PASSWORD@192.168.0.100:554/profile2/media.smp
VIDEO_RECONNECT_SEC=3
VIDEO_READ_TIMEOUT_SEC=10

# ── 모델 / 추론 ──────────────────────────────────────────────────────
MODEL_BACKEND=onnx                 # onnx | torchscript
MODEL_ONNX_PATH=model_files/best_trash.torchscript.onnx
MODEL_TORCHSCRIPT_PATH=model_files/best_trash.torchscript.pt
MODEL_DEVICE=cuda                  # cuda | cpu (cuda 불가 시 자동 cpu 폴백)
MODEL_IMGSZ=640
MODEL_FP16=false                   # torchscript 백엔드에서만 적용
# 첨부 onnx 는 그래프에 sigmoid+grid decode 포함 -> decoded 확정. auto 로 두면 첫 프레임에 자동 판별.
MODEL_INFER_MODE=decoded           # decoded | raw | auto
MODEL_LETTERBOX=true               # false = stretch (카메라 앱과 동일 방식)
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
MAX_DET=300
# 그래프의 ReduceMax 직전 텐서를 노출해 '후처리 전 4클래스'를 로그에 표시(ONNX 전용).
EXPOSE_RAW_CLASSES=true
# 4클래스 이름(모델에 없음). 미지정 시 cls0..cls3 으로 표시.
# CLASS_NAMES=병,캔,비닐,종이

# ── 판정 로직 ────────────────────────────────────────────────────────
WINDOW_SEC=2.0
COUNT_LOW=1
COUNT_HIGH=2
# ⚠ AREA_* 의 단위는 percent(%). 0.3 = 0.3%, 3.0 = 3%.
AREA_LOW=0.3
AREA_HIGH=3.0
AREA_UNIT=percent                  # percent | ratio
COOLDOWN_SEC=8                     # 최소 1초
# IF 맵상 0 = 정회전(능동 명령) 이므로 정상 복귀 시 0 을 써야 라인이 되살아난다.
WRITE_ZERO_ON_NORMAL=true
# 영상/추론이 FAULT_AFTER_SEC 이상 실패하면 코드 9(판정실패) 를 1회 전송한다.
FAULT_CODE=9
FAULT_AFTER_SEC=5
# ROI 폴리곤(선택). "x1,y1;x2,y2;..." — 0~1 정규화 또는 픽셀 좌표. 미지정 시 프레임 전체.
# ROI_POLYGON=0.1,0.2;0.9,0.2;0.9,0.9;0.1,0.9

# ── PLC (XGT 전용 프로토콜, write only) ──────────────────────────────
# IF 맵 Rev.2026.07.03 기준. PC 는 쓰기만 한다 (D8000/D8001 읽기 미사용).
PLC_ENABLED=true
PLC_HOST=192.168.5.199
PLC_PORT=2004
PLC_CPU_INFO=0                     # 0 = CPU_ANY (XGB 계열 권장)
PLC_TIMEOUT_SEC=2
PLC_ADDR_PC_READY=%DW8100          # 0=Off / 1=On
PLC_ADDR_RESULT=%DW8101            # 0 정회전 / 1 정지 / 2 역회전 / 9 알람

# ── 대시보드 ─────────────────────────────────────────────────────────
DASHBOARD_PUBLISH_PORT=1235        # 호스트 게시 포트 (컨테이너 내부는 compose 가 8080 고정)
DASHBOARD_ENABLED=true
DASHBOARD_JPEG_QUALITY=75
DASHBOARD_STREAM_FPS=15

LOG_LEVEL=INFO
