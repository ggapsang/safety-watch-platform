# ── 자격증명 ────────────────────────────────────────────────────────────
# 카메라 RTSP 계정·DB 비밀번호·암호화 키 포함 — 절대 커밋 금지
.env
aivision/deploy/.env

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Node ────────────────────────────────────────────────────────────────
node_modules/
aivision/web/dist/
# tsc 증분 빌드 캐시 — 산출물이라 커밋하지 않는다
aivision/web/tsconfig.tsbuildinfo
# 서버가 서빙하는 빌드 산출물(Docker 빌드가 만든다)
aivision/server/static/

# ── 런타임 데이터 ───────────────────────────────────────────────────────
aivision/server/data/
aivision/models/*
!aivision/models/README.md
*.mp4
*.log

# ── 레거시(refs/) ───────────────────────────────────────────────────────
