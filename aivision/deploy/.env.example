# aivision/deploy/.env — docker-compose.yml 이 같은 폴더에서 자동으로 읽습니다. (주의: 커밋 금지)
# cp .env.example .env 후 값을 채우세요.
#
# 주의: 값 뒤에 주석을 붙이지 마세요. compose 는 = 뒤를 값으로 그대로 읽어 갑니다.

# ── 필수 ────────────────────────────────────────────────────────────────
# 카메라 비밀번호를 DB 에 암호화 저장할 때 쓰는 키. 아래 명령으로 생성합니다.
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_KEY=

# ── 호스트 포트 ─────────────────────────────────────────────────────────
# 흔한 포트(8080/1883/5432)는 다른 프로그램과 잘 부딪혀 118xx 대역으로 옮겼습니다.
# 컨테이너 안쪽은 표준 포트 그대로이고, 호스트에서 보이는 주소만 바뀐 것입니다.
#
#   11880  대시보드 (웹)
#   11881  브로커 WebSocket — 브라우저 'MQTT 로그' 화면이 직결 구독
#   11882  PostgreSQL — psql·DBeaver 등으로 직접 조회
#   11884  미디어 서버 WebRTC (브라우저 저지연 재생, 지금은 미사용)
#   11885  미디어 서버 HLS
#    8554  미디어 서버 RTSP — 분석 모듈이 영상을 가져가는 곳
#
# MQTT TCP 만 표준 포트(1883)를 그대로 씁니다. 카메라 기본값이 1883 이라, 여기를 옮기면
# 현장 카메라마다 설정을 바꿔야 하기 때문입니다. 이 PC 에서 1883 을 쓰는 다른 프로그램만
# 없으면 됩니다(예전에 설치한 Mosquitto 윈도우 서비스가 있으면 먼저 내려야 합니다).
HTTP_PORT=11880
MQTT_WS_PORT=11881
POSTGRES_PORT=11882
WEBRTC_PORT=11884
HLS_PORT=11885
RTSP_PORT=8554
MQTT_TCP_PORT=1883

# 브라우저가 'MQTT 로그' 화면에서 직접 붙을 브로커 주소.
# 다른 PC 에서 접속시킬 거라면 localhost 대신 서버 PC 의 IP 를 적어야 합니다.
MQTT_WS_URL=ws://localhost:11881

# 브라우저가 미디어 서버에 직접 닿을 주소. 다른 PC 에서 볼 거라면 서버 PC 의 IP 로.
MEDIAMTX_PUBLIC_URL=http://localhost:11884

# mediamtx | direct  (direct 는 미디어 서버 없이 카메라 직접 — fan-out·녹화 없음)
MEDIA_BACKEND=mediamtx

# ── 서버 YOLO 사이드카 (docker compose --profile yolo up) ───────────────
# 기본은 꺼져 있습니다. 모델은 aivision/models/ 에 넣으면 /models 로 마운트됩니다.
# 모델 파일이 없으면 모듈이 dry-run(합성 박스)으로 내려앉습니다.
YOLO_MODEL_PATH=/models/best.onnx
# 모델 클래스 -> 탐지 항목 코드. 항목을 플랫폼에 먼저 만들어 두세요.
# 예: {"no_helmet":"ITEM-001","no_vest":"ITEM-002"}
YOLO_CLASS_MAP=
# cpu | cuda  (cuda 를 못 쓰면 자동으로 cpu 로 내려갑니다)
YOLO_DEVICE=cpu
YOLO_SAMPLE_FPS=3
YOLO_HOLD_SEC=3
YOLO_MIN_CONF=0.4
# 출력 텐서 해석: auto | v5 | v8 | nms
YOLO_LAYOUT=auto
YOLO_DRY_RUN=false

# ── 서버 YOLO 모듈 화면 (docker compose --profile yolo up) ─────────────
# 이 모듈은 학습까지 하므로 자기 화면을 갖습니다. 플랫폼이 그 주소를 탭으로 감쌉니다.
# 다른 PC 에서 접속시킬 거라면 localhost 대신 서버 PC 의 IP 로 바꿔야 합니다.
YOLO_UI_PORT=11990
YOLO_PUBLIC_URL=http://localhost:11990
# 학습에 쓸 장치. GPU 번호 또는 cpu. CPU 로는 현실적으로 학습이 안 됩니다.
YOLO_TRAIN_DEVICE=0
# 기본 이미지는 CPU 판 torch 라 어디서든 빌드됩니다. 학습하려면 CUDA 판으로 바꾸세요.
#   YOLO_TORCH_INDEX=https://download.pytorch.org/whl/cu121
YOLO_TORCH_INDEX=https://download.pytorch.org/whl/cpu
# 이 크기(sqrt(w*h) 픽셀)보다 작은 박스는 버립니다. 0 이면 안 버립니다.
YOLO_MIN_BOX_PX=0

# ── 카메라 메타데이터 모듈 (docker compose --profile meta up) ──────────
# 카메라가 이미 만든 박스를 읽어 화면에 그립니다. 이벤트는 만들지 않습니다.
# 예: {"Human":"사람","Face":"얼굴","Vehicle":"차량"}
META_CLASS_MAP=
META_KEEP_UNMAPPED=true
# 그리지 않을 클래스(쉼표 구분). 사람 하나에 Human·Head·Face 가 겹쳐 나오므로
# 안쪽 둘을 빼면 화면이 깔끔합니다. 다 보려면 비우세요.
META_SKIP_CLASSES=Head,Face
META_LIVE_MIN_INTERVAL=0.2

# ── 수신 원문 DB 적재 ───────────────────────────────────────────────────
# 기본은 남기지 않습니다. 'MQTT 로그' 화면은 브로커에 직접 붙으므로 꺼 두어도
# 실시간으로 무엇이 오는지 보는 데는 지장이 없습니다. 관리자 화면에서도 바꿀 수 있습니다.
#   off | unmatched | all
MQTT_LOG_MODE=off
# 특정 채널만 남길 때. 채우면 위 설정보다 우선합니다. 예: +/fireAlarm,vendorX/#
MQTT_LOG_TOPICS=

# ── 상시 녹화 ───────────────────────────────────────────────────────────
# 전체 용량 상한(GB). 넘으면 가장 오래된 영상부터 지웁니다. 0 이면 제한 없음.
# 카메라별 보존 시간은 카메라 설정에서 따로 정합니다(관리자 → 카메라).
# 디스크가 하나이므로 상한도 전체 하나로 둡니다 — 카메라별로 나누면 합이 디스크를
# 넘을 수 있어 정작 막고 싶었던 사고를 못 막습니다.
RECORD_MAX_GB=20
# 녹화를 어디에 쌓을지.
#   recordings            도커 볼륨 (기본). docker volume 으로 관리됩니다
#   D:/aivision-녹화      호스트 폴더. 큰 디스크로 옮길 때 이렇게 씁니다
# 컨테이너 안쪽 경로(/recordings)는 그대로입니다 — 바뀌는 것은 거기에 무엇을 붙이냐입니다.
# 바꾼 뒤에는 docker compose up -d 로 컨테이너를 다시 만들어야 반영됩니다.
# 주의: 옮겨도 기존 녹화가 따라가지 않습니다. 필요하면 파일을 직접 옮기세요.
RECORD_PATH=recordings

# ── DB ──────────────────────────────────────────────────────────────────
# 주의: DB 포트를 외부에 열어 두므로 비밀번호를 반드시 바꾸세요.
POSTGRES_USER=aivision
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aivision

TZ=Asia/Seoul
LOG_LEVEL=INFO
